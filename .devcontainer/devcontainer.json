{
  "name": "BiteShare Platform",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "forwardPorts": [8088],
  "portsAttributes": {
    "8088": {
      "label": "BiteShare Web App",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "nohup python server.py > /tmp/server.log 2>&1 &"
}
